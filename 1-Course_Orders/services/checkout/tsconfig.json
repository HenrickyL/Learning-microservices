{
  "moduleResolution": "node",
  "extends": "../../tsconfig.base.json",
  // "references": [
  //   { "path": "../../shared"}
  // ],
  "compilerOptions": {
    "outDir": "dist",
    "baseUrl": ".",
    "types": ["jest"],
    "paths": {
      "@infra/*": ["./src/infra/*"],
      "@application/*": ["./src/application/*"],
      "@domain/*": ["./src/domain/*"],
      // "@shared/*": ["../../shared/src/*"]
    }
  },
  "include": ["src", "tests"],
  "exclude": ["node_modules", "dist"],
  "references": [
    { "path": "../../shared" }
  ]
}
