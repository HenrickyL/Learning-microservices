datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}


model Course {
  course_id String   @id @default(uuid())
  title     String
  amount    Decimal

  orders    Order[]  @relation("CourseOrders")
  
  @@map("Course")
}

model Order {
  order_id  String   @id @default(uuid())
  course_id String
  name      String
  email     String
  status    String
  amount    Decimal

  course    Course   @relation("CourseOrders", fields: [course_id], references: [course_id])
  
  @@map("Order")
}