generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model course {
  course_id String   @id @default(uuid())
  title     String
  amount    Decimal

  orders    order[]  @relation("CourseOrders")
  
  @@map("course")
}

model order {
  order_id  String   @id @default(uuid())
  course_id String
  name      String
  email     String
  status    String
  amount    Decimal

  course    course   @relation("CourseOrders", fields: [course_id], references: [course_id])
  
  @@map("order")
}